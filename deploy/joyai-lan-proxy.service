[Unit]
Description=Authenticated LAN proxy for JoyAI
After=network-online.target joyai-vllm.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/media-workbench/app
EnvironmentFile=%h/.config/joyai-lan-proxy.env
ExecStart=/usr/bin/python3 /srv/media-workbench/app/deploy/joyai_lan_proxy.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
